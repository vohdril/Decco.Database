<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Decco.Database.Runner</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- dbup-sqlserver 7.2.0 (2026-02-24) traz dbup-core >= 6.1.1 e Microsoft.Data.SqlClient >= 6.1.4.
         Conferir no primeiro `dotnet restore` se as versões resolvidas batem. -->
    <PackageReference Include="dbup-core" Version="6.1.1" />
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
  </ItemGroup>

</Project>
